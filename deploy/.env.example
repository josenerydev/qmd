# ============================================================================
# qmd-mcp — runtime configuration (copy to .env and fill in)
# LLM over the OpenAI spec, direct: any compatible endpoint works (OpenAI,
# OpenRouter, your own gateway...). The adapter appends /embeddings and /rerank
# to the base URL. Switching provider = editing ONLY this file.
# ============================================================================

# --- Remote LLM provider (OpenAI spec) ---------------------------------------
QMD_LLM_PROVIDER=remote
# E.g. OpenRouter: https://openrouter.ai/api/v1 | OpenAI: https://api.openai.com/v1
QMD_LLM_BASE_URL=https://openrouter.ai/api/v1
QMD_LLM_API_KEY=
# Models in YOUR provider's naming (on OpenRouter, prefixed: openai/..., cohere/...):
QMD_EMBED_MODEL=openai/text-embedding-3-small
QMD_RERANK_MODEL=cohere/rerank-4-fast

# --- MCP ---------------------------------------------------------------------
# Bearer required on /mcp (without it the endpoint is OPEN — the server logs a warning):
QMD_MCP_AUTH_TOKEN=
QMD_MCP_PORT=8181

# --- Sources -----------------------------------------------------------------
# Preferred: sources/sources.yaml (multi-source; see sources.example.yaml).
# SINGLE-SOURCE fallback (used only when there is no sources.yaml):
# QMD_SOURCE_REPO_URL=https://github.com/<org>/<repo>
# QMD_SOURCE_REPO_TOKEN=
# QMD_SOURCE_REPO_BRANCH=main
# QMD_SOURCE_REPO_MASK=**/*.md
# QMD_SOURCE_CONTEXT=Source description (context injected into search results)

# --- Periodic refresh (optional) ---------------------------------------------
# Seconds between automatic refreshes (git pull + reindex + embed) of the sources.
# Empty/0 = OFF: index refreshed only at boot or on demand via the MCP `refresh` tool.
REFRESH_INTERVAL=
