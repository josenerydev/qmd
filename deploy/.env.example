# ============================================================================
# qmd-mcp — configuração de runtime (copie para .env e preencha)
# LLM via spec OpenAI direto: qualquer endpoint compatível serve (OpenAI,
# OpenRouter, gateway próprio...). O adapter anexa /embeddings e /rerank à
# base URL. Trocar de provedor = editar SÓ este arquivo.
# ============================================================================

# --- Provider LLM remoto (spec OpenAI) ---------------------------------------
QMD_LLM_PROVIDER=remote
# Ex.: OpenRouter: https://openrouter.ai/api/v1 | OpenAI: https://api.openai.com/v1
QMD_LLM_BASE_URL=https://openrouter.ai/api/v1
QMD_LLM_API_KEY=
# Modelos no formato do SEU provedor:
QMD_EMBED_MODEL=text-embedding-3-small
QMD_RERANK_MODEL=

# --- MCP ---------------------------------------------------------------------
# Bearer exigido no /mcp (sem ele o endpoint fica ABERTO — o server loga aviso):
QMD_MCP_AUTH_TOKEN=
QMD_MCP_PORT=8181

# --- Fontes ------------------------------------------------------------------
# Preferido: sources/sources.yaml (multi-fonte; ver sources.example.yaml).
# Fallback de FONTE ÚNICA (usado só quando não há sources.yaml):
# QMD_SOURCE_REPO_URL=https://github.com/<org>/<repo>
# QMD_SOURCE_REPO_TOKEN=
# QMD_SOURCE_REPO_BRANCH=main
# QMD_SOURCE_REPO_MASK=**/*.md
# QMD_SOURCE_CONTEXT=Descrição da fonte (contexto injetado nas buscas)

# --- Refresh periódico (opcional) --------------------------------------------
# Segundos entre refreshes automáticos (git pull + reindex + embed) das fontes.
# Vazio/0 = DESLIGADO: índice fresco só no boot ou sob demanda pela tool MCP `refresh`.
REFRESH_INTERVAL=
